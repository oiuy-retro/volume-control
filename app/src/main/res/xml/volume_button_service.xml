<?xml version="1.0" encoding="utf-8"?>
<!-- Key event filtering only. accessibilityEventTypes is left out on purpose (no event
     types are requested), packageNames limits any event to this app, and window content
     cannot be retrieved. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:canRetrieveWindowContent="false"
    android:description="@string/volume_button_service_description"
    android:isAccessibilityTool="false"
    android:notificationTimeout="0"
    android:packageNames="com.oiuy.volumecontrol"
    android:settingsActivity="com.oiuy.volumecontrol.MainActivity"
    android:summary="@string/volume_button_service_summary"
    tools:ignore="UnusedAttribute" />
