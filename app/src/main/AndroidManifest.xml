<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Normal (install-time) permission. Samsung's own Music app declares it alongside its
         fine-volume calls; the diagnostic declares it so a missing permission is not the cause
         of a failed test. -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.VolumeControl">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.VolumeControl">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Reads only the hardware volume buttons; see res/xml/volume_button_service.xml. -->
        <service
            android:name=".buttons.VolumeButtonService"
            android:exported="true"
            android:label="@string/volume_button_service_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/volume_button_service" />
        </service>

        <receiver
            android:name=".widget.VolumeDialWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="android.media.VOLUME_CHANGED_ACTION" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/volume_dial_widget_info" />
        </receiver>
    </application>
</manifest>
